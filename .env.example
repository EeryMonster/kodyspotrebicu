# Šablona pro lokální .env. Zkopírujte na .env a doplňte hodnoty.
# Soubor .env je v .gitignore a NIKDY se nesmí commitovat — citlivé údaje
# patří do Vercel Environment Variables, ne do gitu.

# Neon Postgres connection string
# Získejte v Neon dashboardu → Connection details
DATABASE_URL="postgresql://neondb_owner:HESLO@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Heureka Affiliate partner tag
# Vyplňte po schválení v affiliate.heureka.cz. Bez tagu odkazy fungují,
# jen netrackují provizi.
NEXT_PUBLIC_HEUREKA_PARTNER_ID=

# Resend.com API key pro odesílání e-mailových notifikací
# (komentáře, servisní poptávky)
RESEND_API_KEY=

# E-mail kam chodí notifikace o nových komentářích a servisních leadech
NOTIFY_EMAIL=info@kodyspotrebicu.cz
